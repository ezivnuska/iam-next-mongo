# .env.staging — values that DIFFER from production for the staging environment.
# Copy this file to .env.staging on the VPS at /var/www/staging.iameric.me/iam-next-mongo/.env.staging
# All other variables (AWS keys, Stripe keys, Resend, etc.) can be the same as production
# or point to separate test accounts — use test-mode keys for Stripe.

# App URLs — point to staging subdomain
NEXTAUTH_URL=https://staging.iameric.me
NEXT_PUBLIC_APP_URL=https://staging.iameric.me
NEXT_PUBLIC_BASE_URL=https://staging.iameric.me

# Optional: use a separate staging database to avoid polluting production data.
# If omitted, staging shares the production database (acceptable for initial setup).
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/iam-staging?retryWrites=true&w=majority

# Keep GAMES_TOKEN_SECRET the same as production so SSO with games.iameric.me still works.
# If you want staging games to use a separate games deployment, set a different value here
# and point NEXT_PUBLIC_GAMES_URL to that deployment.
# NEXT_PUBLIC_GAMES_URL=https://games.iameric.me

# Stripe — use test-mode keys on staging so no real charges are made.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (from Stripe test webhook endpoint)

# Server — port is set by ecosystem.staging.config.js (3001); do not override here
# PORT=3001
