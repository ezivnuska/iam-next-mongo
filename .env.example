# MongoDB
MONGO_URI=                        # MongoDB connection string (Atlas: mongodb+srv://... or local: mongodb://localhost:27017/dbname)

# Authentication — NextAuth.js
NEXTAUTH_URL=                     # Full URL of this app (e.g. https://iameric.me or http://localhost:3000)
NEXTAUTH_SECRET=                  # Random 32+ char secret: `openssl rand -base64 32`
AUTH_SECRET=                      # Same value as NEXTAUTH_SECRET (used by Next.js middleware edge runtime)

# Internal API security
INTERNAL_SECRET=                  # Secret for server-to-server requests (e.g. cron jobs calling internal endpoints)
CRON_SECRET=                      # Secret for protecting cron job endpoints

# App URL (public, used by Socket.IO CORS and client-side API calls)
NEXT_PUBLIC_APP_URL=              # e.g. https://iameric.me
NEXT_PUBLIC_BASE_URL=             # Base URL for client-side use (usually same as NEXT_PUBLIC_APP_URL)

# GitHub (optional — used for public repo data display)
NEXT_PUBLIC_GITHUB_TOKEN=         # GitHub personal access token with public_repo scope

# AWS S3 (image storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=                       # e.g. us-west-1
AWS_BUCKET_NAME=                  # e.g. iameric-bucket

# Email (Resend)
RESEND_API_KEY=                   # From resend.com dashboard
EMAIL_FROM=                       # Verified sender address, e.g. noreply@iameric.me

# Stripe (payments)
STRIPE_SECRET_KEY=                # sk_live_... or sk_test_...
STRIPE_PUBLISHABLE_KEY=           # pk_live_... or pk_test_... (exposed to client)
STRIPE_WEBHOOK_SECRET=            # whsec_... from Stripe webhook settings

# Server
PORT=3000                         # HTTP port (default 3000; use 3001 for staging)
